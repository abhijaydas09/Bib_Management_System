<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Participant Verification</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light">

<div class="container py-5">
  <div class="card shadow p-4">
    <h2 class="mb-4 text-center text-primary">Participant Verification</h2>

    <div class="mb-3">
      <h4><span class="text-muted">Name:</span> <%= registration.firstName %> <%= registration.lastName %></h4>
      <h5>
        <span class="text-muted">Bib Status:</span> 
        <span class="<%= registration.bibCollectionStatus === 'Collected' ? 'text-success' : 'text-danger' %>">
          <%= registration.bibCollectionStatus %>
        </span>
      </h5>
      <h5>
        <span class="text-muted">Attendance Status:</span> 
        <span class="<%= registration.attendanceStatus === 'Present' ? 'text-success' : 'text-danger' %>">
          <%= registration.attendanceStatus || 'Not Marked' %>
        </span>
      </h5>
    </div>

    <div class="row">
      <div class="col-md-6 mb-3">
        <div class="card p-3">
          <h5>Mark Bib Collected</h5>
          <% if (registration.bibCollectionStatus === 'Collected') { %>
            <div class="alert alert-success text-center">Already Collected</div>
          <% } else { %>
            <form action="/api/registration/markBib/<%= registration.qrCode %>" method="POST">
              <div class="mb-3">
                <label class="form-label">Staff Name</label>
                <input type="text" name="staffName" class="form-control" required>
              </div>
              <button type="submit" class="btn btn-success w-100">Mark Bib Collected</button>
            </form>
          <% } %>
        </div>
      </div>

      <div class="col-md-6 mb-3">
        <div class="card p-3">
          <h5>Mark Attendance</h5>
          <% if (registration.attendanceStatus === 'Present') { %>
            <div class="alert alert-success text-center">Already Marked</div>
          <% } else { %>
            <form action="/api/registration/markAttendance/<%= registration.qrCode %>" method="POST">
              <div class="mb-3">
                <label class="form-label">Staff Name</label>
                <input type="text" name="staffName" class="form-control" required>
              </div>
              <button type="submit" class="btn btn-primary w-100">Mark Attendance</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>

  </div>
</div>

</body>
</html>